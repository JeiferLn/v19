{
  "name": "@v19/supabase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "gen:types": "supabase gen types typescript --local --workdir ../.. > src/database.types.ts && prettier --write src/database.types.ts",
    "lint": "eslint .",
    "db:start": "supabase start --workdir ../..",
    "db:stop": "supabase stop --workdir ../..",
    "db:reset": "supabase db reset --workdir ../..",
    "db:status": "supabase status --workdir ../.."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.1"
  },
  "devDependencies": {
    "@v19/config": "workspace:*",
    "typescript": "~6.0.3",
    "eslint": "~9.39.5",
    "supabase": "^3.2.0",
    "prettier": "^3.10.1"
  }
}
