# Next.js — copiar a apps/web/.env.local
# Solo variables públicas (NEXT_PUBLIC_*): se incrustan en el bundle del navegador.
# NUNCA pongas aquí SUPABASE_SERVICE_ROLE_KEY, OPENAI_API_KEY ni SHOPIFY_* (van en apps/api/.env).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
