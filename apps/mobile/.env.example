# Expo — copiar a apps/mobile/.env.local
# Solo variables públicas (EXPO_PUBLIC_*): se incrustan en el bundle de la app.
# NUNCA pongas aquí SUPABASE_SERVICE_ROLE_KEY, OPENAI_API_KEY ni SHOPIFY_* (van en apps/api/.env).
# En dispositivo físico, cambia localhost por la IP LAN de tu máquina.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
