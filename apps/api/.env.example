# FastAPI — copiar a apps/api/.env (lo lee app/core/config.py desde el directorio apps/api)
# Único lugar con secretos server-side. Nunca prefijar con NEXT_PUBLIC_/EXPO_PUBLIC_.
APP_ENV=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Supabase (service role: omite RLS — solo backend)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shopify
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
